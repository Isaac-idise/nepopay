# Copy to .env (never commit .env)
DATABASE_URL=jdbc:postgresql://localhost:5432/nepopay
DATABASE_USERNAME=nepopay
DATABASE_PASSWORD=change_me_locally
# At least 32 random characters. Generate one, never reuse the dev default in production.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
ALLOWED_ORIGINS=http://localhost:5173
# Set to native when deployed behind a proxy, so rate limits see real client IPs
FORWARD_HEADERS=none
